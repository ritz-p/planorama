{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planorama coverage report version 1",
  "type": "object",
  "required": ["schema_version", "analysis", "cross_state", "summary", "states", "details"],
  "properties": {
    "schema_version": { "const": 1 },
    "analysis": { "const": "state_local_supported_rules_only" },
    "cross_state": { "const": "not_collected" },
    "summary": { "$ref": "#/$defs/summary" },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "summary"],
        "properties": {
          "state": { "type": "string" },
          "summary": { "$ref": "#/$defs/summary" }
        }
      }
    },
    "details": {
      "type": "object",
      "required": ["enabled", "limit", "resources", "findings"],
      "properties": {
        "enabled": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "resources": {
          "allOf": [
            { "$ref": "#/$defs/records" },
            { "properties": { "records": { "items": { "$ref": "#/$defs/resource" } } } }
          ]
        },
        "findings": {
          "allOf": [
            { "$ref": "#/$defs/records" },
            { "properties": { "records": { "items": { "$ref": "#/$defs/finding" } } } }
          ]
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "histogram": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "counts": {
      "type": ["object", "null"],
      "required": ["resources", "account_applicable", "unknown_account", "region_applicable", "unknown_region"],
      "properties": {
        "resources": { "$ref": "#/$defs/count" },
        "account_applicable": { "$ref": "#/$defs/count" },
        "unknown_account": { "$ref": "#/$defs/count" },
        "region_applicable": { "$ref": "#/$defs/count" },
        "unknown_region": { "$ref": "#/$defs/count" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["collected", "input_complete", "input", "selected", "excluded", "input_findings", "selected_findings", "unassociated_input_findings", "selection"],
      "properties": {
        "collected": { "type": "boolean" },
        "input_complete": { "type": ["boolean", "null"] },
        "input": { "$ref": "#/$defs/counts" },
        "selected": { "$ref": "#/$defs/counts" },
        "excluded": { "$ref": "#/$defs/nullableCount" },
        "input_findings": { "$ref": "#/$defs/histogram" },
        "selected_findings": { "$ref": "#/$defs/histogram" },
        "unassociated_input_findings": { "$ref": "#/$defs/nullableCount" },
        "selection": {
          "type": "object",
          "required": ["collected", "direct", "additional_context", "retention_reasons"],
          "properties": {
            "collected": { "type": "boolean" },
            "direct": { "$ref": "#/$defs/nullableCount" },
            "additional_context": { "$ref": "#/$defs/nullableCount" },
            "retention_reasons": { "$ref": "#/$defs/histogram" }
          }
        }
      }
    },
    "records": {
      "type": "object",
      "required": ["total", "omitted", "records_complete", "truncated", "records"],
      "properties": {
        "total": { "$ref": "#/$defs/nullableCount" },
        "omitted": { "$ref": "#/$defs/nullableCount" },
        "records_complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "records": { "type": "array", "maxItems": 1000 }
      }
    },
    "identity": {
      "type": "object",
      "required": ["state", "address", "mode", "deposed"],
      "properties": {
        "state": { "type": "string" },
        "address": { "type": "string" },
        "mode": { "enum": ["managed", "data"] },
        "deposed": { "type": ["string", "null"] }
      }
    },
    "resource": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "required": ["selection", "retention_reasons"],
          "properties": {
            "selection": { "enum": ["direct", "context", null] },
            "retention_reasons": {
              "type": ["array", "null"],
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "finding": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "required": ["attribute", "reason", "category", "message"],
          "properties": {
            "attribute": { "type": ["string", "null"] },
            "reason": { "type": "string" },
            "category": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  }
}
