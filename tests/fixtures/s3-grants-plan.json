{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "resource_changes": [
    {
      "address": "aws_iam_role.location",
      "type": "aws_iam_role",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "arn": "arn:aws:iam::111111111111:role/location"
        }
      }
    },
    {
      "address": "aws_iam_user.reader",
      "type": "aws_iam_user",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "arn": "arn:aws:iam::111111111111:user/reader"
        }
      }
    },
    {
      "address": "aws_s3control_access_grants_location.main",
      "type": "aws_s3control_access_grants_location",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "access_grants_location_id": "location-123",
          "iam_role_arn": "arn:aws:iam::111111111111:role/location",
          "location_scope": "s3://private-location-sentinel/*"
        }
      }
    },
    {
      "address": "aws_s3control_access_grant.main",
      "type": "aws_s3control_access_grant",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "access_grant_id": "grant-456",
          "access_grants_location_id": "location-123",
          "permission": "READ",
          "grantee": [
            {
              "grantee_type": "IAM",
              "grantee_identifier": "arn:aws:iam::111111111111:user/reader"
            }
          ]
        }
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": {
        "full_name": "registry.terraform.io/hashicorp/aws",
        "expressions": {
          "region": {
            "constant_value": "us-east-1"
          }
        }
      }
    },
    "root_module": {
      "resources": [
        {
          "address": "aws_iam_role.location",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_iam_user.reader",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_s3control_access_grants_location.main",
          "provider_config_key": "aws",
          "expressions": {
            "iam_role_arn": {
              "references": [
                "aws_iam_role.location.arn"
              ]
            }
          }
        },
        {
          "address": "aws_s3control_access_grant.main",
          "provider_config_key": "aws",
          "expressions": {
            "access_grants_location_id": {
              "references": [
                "aws_s3control_access_grants_location.main.access_grants_location_id"
              ]
            },
            "grantee": [
              {
                "grantee_identifier": {
                  "references": [
                    "aws_iam_user.reader.arn"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
