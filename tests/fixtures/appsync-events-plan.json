                    {
                      "user_pool_id": "us-east-1_first",
                      "aws_region": "us-east-1"
                    }
                  ]
                },
                {
                  "auth_type": "AMAZON_COGNITO_USER_POOLS",
                  "cognito_config": [
                    {
                      "user_pool_id": "us-east-1_second",
