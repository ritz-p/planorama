                    {
                      "authorizer_uri": "arn:aws:lambda:us-east-1:111111111111:function:authorizer",
                      "identity_validation_expression": "PRIVATE_AUTH_PAYLOAD"
                    }
                  ]
                },
                {
                  "auth_type": "AWS_IAM"
                }
              ],
              "log_config": [
                {
                  "cloudwatch_logs_role_arn": "arn:aws:iam::111111111111:role/event-logs",
                  "log_level": "ERROR"
                }
              ]
            }
          ]
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_appsync_datasource.events",
      "mode": "managed",
      "type": "aws_appsync_datasource",
      "name": "events",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
