          "name": "shared-source",
          "type": "NONE"
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_appsync_channel_namespace.events",
      "mode": "managed",
      "type": "aws_appsync_channel_namespace",
      "name": "events",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "api_id": "event-api",
          "name": "updates",
          "code_handlers": "PRIVATE_HANDLER_PAYLOAD",
          "handler_configs": [
            {
              "on_publish": [
                {
                  "behavior": "CODE",
                  "integration": [
                    {
                      "data_source_name": "shared-source"
                    }
                  ]
                }
              ],
              "on_subscribe": [
                {
                  "behavior": "DIRECT",
                  "integration": [
                    {
                      "data_source_name": "shared-source"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "after_unknown": {}
