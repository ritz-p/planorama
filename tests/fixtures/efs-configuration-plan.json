      "type": "aws_security_group",
      "change": {
        "actions": [
          "no-op"
        ],
        "after": {
          "id": "sg-synthetic",
          "vpc_id": "vpc-synthetic"
        }
      }
    },
    {
      "address": "aws_kms_key.efs",
      "type": "aws_kms_key",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "id": "example",
          "arn": "arn:aws:kms:us-east-1:123456789012:key/example"
        }
      }
    },
    {
      "address": "aws_efs_backup_policy.app",
      "type": "aws_efs_backup_policy",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "file_system_id": "fs-synthetic",
          "backup_policy": [
            {
              "status": "ENABLED"
            }
          ]
        }
      }
    },
    {
      "address": "aws_efs_file_system_policy.app",
      "type": "aws_efs_file_system_policy",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "file_system_id": "fs-synthetic",
          "policy": "PRIVATE_POLICY"
        }
      }
    },
    {
      "address": "aws_efs_file_system.replica",
      "type": "aws_efs_file_system",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "id": "fs-replica"
        }
      }
    },
    {
      "address": "aws_kms_alias.replica",
      "type": "aws_kms_alias",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "name": "alias/replica",
          "arn": "arn:aws:kms:us-west-2:123456789012:alias/replica"
        }
      }
    },
    {
      "address": "aws_efs_replication_configuration.app",
      "type": "aws_efs_replication_configuration",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "source_file_system_id": "fs-synthetic",
          "destination": [
            {
              "file_system_id": "fs-replica",
              "kms_key_id": "alias/replica",
              "region": "us-west-2"
            }
          ]
        }
      }
    }
  ],
