{
  "format_version": "1.2",
  "resource_changes": [
    {
      "address": "aws_efs_file_system.shared",
      "type": "aws_efs_file_system",
      "change": {
        "actions": [
          "no-op"
        ],
        "after": {
          "id": "fs-synthetic",
          "encrypted": true,
          "kms_key_id": "arn:aws:kms:us-east-1:123456789012:key/example"
        }
      }
    },
    {
      "address": "aws_efs_mount_target.app",
      "type": "aws_efs_mount_target",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "file_system_id": "fs-synthetic",
          "subnet_id": "subnet-synthetic",
          "security_groups": [
            "sg-synthetic"
          ]
        }
      }
    },
    {
      "address": "aws_efs_access_point.app",
      "type": "aws_efs_access_point",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "file_system_id": "fs-synthetic",
          "root_directory": [
            {
              "path": "PRIVATE_PATH"
            }
          ],
          "posix_user": [
            {
              "uid": 12345,
              "gid": 12345
            }
          ]
        }
      }
    },
    {
      "address": "aws_subnet.app",
      "type": "aws_subnet",
      "change": {
        "actions": [
          "no-op"
        ],
