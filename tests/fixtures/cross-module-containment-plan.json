{
  "format_version": "1.2",
  "resource_changes": [
    {"address":"module.network.aws_vpc.main","type":"aws_vpc","change":{"actions":["create"]}},
    {"address":"module.network.aws_subnet.private","type":"aws_subnet","change":{"actions":["create"]}},
    {"address":"module.application.aws_instance.app","type":"aws_instance","change":{"actions":["create"]}}
