    "application":{"expressions":{"subnet_id":{"references":["module.network.subnet_id"]}},"module":{"resources":[
      {"address":"aws_instance.app","expressions":{"subnet_id":{"references":["var.subnet_id"]}}}
    ]}}
  }}}
}
