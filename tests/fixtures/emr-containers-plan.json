{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "resource_changes": [
    {
      "address": "aws_eks_cluster.main",
      "type": "aws_eks_cluster",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "name": "workloads"
        }
      }
    },
    {
      "address": "aws_iam_role.emr",
      "type": "aws_iam_role",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "arn": "arn:aws:iam::123456789012:role/emr"
        }
      }
    },
    {
      "address": "aws_kms_key.logs",
      "type": "aws_kms_key",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "arn": "arn:aws:kms:us-east-1:123456789012:key/00000000-1111-2222-3333-444444444444"
        }
      }
    },
    {
      "address": "aws_s3_bucket.logs",
      "type": "aws_s3_bucket",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "bucket": "example-emr-logs"
        }
      }
    },
    {
      "address": "aws_cloudwatch_log_group.logs",
      "type": "aws_cloudwatch_log_group",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "name": "/example/jobs"
        }
      }
    },
    {
      "address": "aws_emrcontainers_virtual_cluster.main",
      "type": "aws_emrcontainers_virtual_cluster",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "container_provider": [
            {
              "id": "workloads",
              "type": "EKS",
              "info": [
                {
                  "eks_info": [
                    {
                      "namespace": "jobs"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "address": "aws_emrcontainers_job_template.main",
      "type": "aws_emrcontainers_job_template",
      "mode": "managed",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "kms_key_arn": "arn:aws:kms:us-east-1:123456789012:key/00000000-1111-2222-3333-444444444444",
          "job_template_data": [
            {
              "execution_role_arn": "arn:aws:iam::123456789012:role/emr",
              "configuration_overrides": [
                {
                  "monitoring_configuration": [
                    {
                      "cloud_watch_monitoring_configuration": [
                        {
                          "log_group_name": "/example/jobs"
                        }
                      ],
                      "s3_monitoring_configuration": [
                        {
                          "log_uri": "s3://example-emr-logs/jobs"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": {
        "full_name": "registry.terraform.io/hashicorp/aws",
        "version_constraint": "6.70.0",
        "expressions": {
          "region": {
            "constant_value": "us-east-1"
          },
          "assume_role": [
            {
              "role_arn": {
                "constant_value": "arn:aws:iam::123456789012:role/Test"
              }
            }
          ]
        }
      }
    },
    "root_module": {
      "resources": [
        {
          "address": "aws_eks_cluster.main",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_iam_role.emr",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_kms_key.logs",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_s3_bucket.logs",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_cloudwatch_log_group.logs",
          "provider_config_key": "aws",
          "expressions": {}
        },
        {
          "address": "aws_emrcontainers_virtual_cluster.main",
          "provider_config_key": "aws",
          "expressions": {
            "container_provider": [
              {
                "id": {
                  "references": [
                    "aws_eks_cluster.main.name"
                  ]
                }
              }
            ]
          }
        },
        {
          "address": "aws_emrcontainers_job_template.main",
          "provider_config_key": "aws",
          "expressions": {
            "kms_key_arn": {
              "references": [
                "aws_kms_key.logs.arn"
              ]
