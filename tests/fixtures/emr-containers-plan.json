            "job_template_data": [
              {
                "execution_role_arn": {
                  "references": [
                    "aws_iam_role.emr.arn"
                  ]
                },
                "configuration_overrides": [
                  {
                    "monitoring_configuration": [
                      {
                        "cloud_watch_monitoring_configuration": [
                          {
                            "log_group_name": {
                              "references": [
                                "aws_cloudwatch_log_group.logs.name"
                              ]
                            }
                          }
                        ],
                        "s3_monitoring_configuration": [
                          {
                            "log_uri": {
                              "references": [
                                "aws_s3_bucket.logs.bucket"
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
